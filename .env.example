# Environment configuration for the Agentic AI Job Application Assistant.
# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.

# ---------------------------------------------------------------------------
# LLM provider (optional). Without a key the app runs in deterministic mode:
# every feature still works using rule-based engines.
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key-here
# Optional: point at a compatible gateway / proxy / local server.
# OPENAI_BASE_URL=
LLM_TEMPERATURE=0
LLM_TIMEOUT=45
LLM_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Storage and limits
# ---------------------------------------------------------------------------
# DB_PATH=data/applications.db
MAX_UPLOAD_MB=5
MAX_RESUME_CHARS=12000
